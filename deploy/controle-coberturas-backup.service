[Unit]
Description=Backup do banco de Controle de Coberturas
After=controle-coberturas.service

[Service]
Type=oneshot
User=coberturas
Group=coberturas
WorkingDirectory=/opt/controle-coberturas/current
EnvironmentFile=/etc/controle-coberturas.env
ExecStart=/usr/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/controle-coberturas /var/backups/controle-coberturas
Nice=15
